import geopandas as gpd
import folium

# 1. Carregar os dados
grid = gpd.read_file('grid_2kmX2km.shp').to_crs(epsg=4326)
poligonos = gpd.read_file('Poligono_ESPECIES_anfibios.shp').to_crs(epsg=4326)

# Tentar carregar pontos
try:
    pontos = gpd.read_file('lista_ESPECIES_anfibios.shp').to_crs(epsg=4326)
    tem_pontos = True
except Exception:
    tem_pontos = False

# 2. Centrar o mapa
centro_lat = grid.geometry.centroid.y.mean()
centro_lon = grid.geometry.centroid.x.mean()

mapa = folium.Map(
    location=[centro_lat, centro_lon],
    zoom_start=8,
    tiles='OpenStreetMap'
)

# Adicionar Imagem de Satélite
folium.TileLayer(
    tiles='https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',
    attr='Esri',
    name='Imagem de Satélite (Esri)',
    overlay=False
).add_to(mapa)

# 3. Adicionar o Grid (desativado por padrão)
folium.GeoJson(
    grid,
    name='Grid de Amostragem (2km x 2km)',
    show=False,
    style_function=lambda x: {
        'fillColor': '#3186cc',
        'color': '#555555',
        'weight': 0.8,
        'fillOpacity': 0.1
    }
).add_to(mapa)

# 4. Tentar identificar a coluna de nome da espécie
colunas_texto = poligonos.select_dtypes(include=['object']).columns.tolist()

if colunas_texto:
    col_nome = colunas_texto[0] # pega a primeira coluna de texto
    for valor_especie in sorted(poligonos[col_nome].dropna().unique()):
        grupo = folium.FeatureGroup(name=f"Espécie: {valor_especie}", show=False)
        
        # Filtra polígonos
        sub_poly = poligonos[poligonos[col_nome] == valor_especie]
        folium.GeoJson(
            sub_poly,
            style_function=lambda x: {'fillColor': '#ff7800', 'color': '#ff7800', 'weight': 2, 'fillOpacity': 0.4},
            tooltip=folium.GeoJsonTooltip(fields=list(sub_poly.columns.drop('geometry')))
        ).add_to(grupo)
        
        # Filtra pontos (se houver a mesma coluna nos pontos)
        if tem_pontos and col_nome in pontos.columns:
            sub_pts = pontos[pontos[col_nome] == valor_especie]
            if not sub_pts.empty:
                folium.GeoJson(
                    sub_pts,
                    marker=folium.CircleMarker(radius=4, color='red', fill=True, fill_color='red'),
                    tooltip=folium.GeoJsonTooltip(fields=list(sub_pts.columns.drop('geometry')))
                ).add_to(grupo)
                
        grupo.add_to(mapa)
else:
    # Se não houver coluna de texto, adiciona todos individualmente por índice
    for idx, row in poligonos.iterrows():
        grupo = folium.FeatureGroup(name=f"Polígono {idx + 1}", show=False)
        folium.GeoJson(
            row['geometry'],
            style_function=lambda x: {'fillColor': '#ff7800', 'color': '#ff7800', 'weight': 2, 'fillOpacity': 0.4}
        ).add_to(grupo)
        grupo.add_to(mapa)

# 5. Adicionar Controle de Camadas
folium.LayerControl(collapsed=False).add_to(mapa)

# Guardar
mapa.save('index.html')
