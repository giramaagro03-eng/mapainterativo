import geopandas as gpd
import folium

# 1. Carregar os dados
grid = gpd.read_file('grid_2kmX2km.shp').to_crs(epsg=4326)
poligonos_fauna = gpd.read_file('Poligono_ESPECIES_anfibios.shp').to_crs(epsg=4326)

# Carregar pontos se o ficheiro existir
try:
    pontos_fauna = gpd.read_file('lista_ESPECIES_anfibios.shp').to_crs(epsg=4326)
    tem_pontos = True
except Exception:
    tem_pontos = False

# 2. Centrar o mapa no Grid/Paraíba
centro_lat = grid.geometry.centroid.y.mean()
centro_lon = grid.geometry.centroid.x.mean()

mapa = folium.Map(
    location=[centro_lat, centro_lon],
    zoom_start=8,
    tiles='OpenStreetMap'
)

# Adicionar mapa base de Imagem de Satélite
folium.TileLayer(
    tiles='https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',
    attr='Esri',
    name='Imagem de Satélite (Esri)',
    overlay=False
).add_to(mapa)

# 3. Adicionar o Grid (desativado por defeito para não poluir a vista)
folium.GeoJson(
    grid,
    name='Grid de Amostragem (2km x 2km)',
    show=False,
    style_function=lambda x: {
        'fillColor': '#3186cc',
        'color': '#555555',
        'weight': 0.8,
        'fillOpacity': 0.1
    },
    tooltip=folium.GeoJsonTooltip(
        fields=list(grid.columns.drop('geometry')),
        localize=True
    )
).add_to(mapa)

# 4. Descobrir o nome da coluna que contém o nome da espécie
colunas_possiveis = ['NM_ESPECIE', 'especie', 'ESPECIE', 'species', 'Species', 'nome_cient']
coluna_especie = next((c for c in colunas_possiveis if c in poligonos_fauna.columns), None)

if not coluna_especie:
    coluna_especie = poligonos_fauna.select_dtypes(include=['object']).columns[0]

# 5. Criar uma camada individual para cada espécie de polígono
especies_unicas = sorted(poligonos_fauna[coluna_especie].dropna().unique())

for especie in especies_unicas:
    grupo_especie = folium.FeatureGroup(name=f"Espécie: {especie}", show=False)
    
    # Filtrar o polígono da espécie atual
    poly_sub = poligonos_fauna[poligonos_fauna[coluna_especie] == especie]
    
    folium.GeoJson(
        poly_sub,
        style_function=lambda x: {
            'fillColor': '#e65100',
            'color': '#b23c00',
            'weight': 2,
            'fillOpacity': 0.4
        },
        tooltip=folium.GeoJsonTooltip(
            fields=list(poly_sub.columns.drop('geometry')),
            localize=True
        )
    ).add_to(grupo_especie)
    
    # Adicionar pontos correspondentes se existirem
    if tem_pontos and coluna_especie in pontos_fauna.columns:
        pontos_sub = pontos_fauna[pontos_fauna[coluna_especie] == especie]
        if not pontos_sub.empty:
            folium.GeoJson(
                pontos_sub,
                marker=folium.CircleMarker(radius=4, color='darkred', fill=True, fill_color='red'),
                tooltip=folium.GeoJsonTooltip(fields=list(pontos_sub.columns.drop('geometry')))
            ).add_to(grupo_especie)
            
    grupo_especie.add_to(mapa)

# 6. Adicionar controlo de camadas no canto superior direito
folium.LayerControl(collapsed=False).add_to(mapa)

# 7. Guardar o mapa
mapa.save('index.html')
print(f"Mapa gerado com sucesso! {len(especies_unicas)} espécies adicionadas ao menu.")
